{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Rust: Format and lint",
      "type": "process",
      "command": "bash",
      "args": [
        "${workspaceFolder}/scripts/format.sh"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": "$rustc"
    },
    {
      "label": "Rust: Check formatting and lint",
      "type": "process",
      "command": "bash",
      "args": [
        "${workspaceFolder}/scripts/format.sh",
        "--check"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": "$rustc"
    },
    {
      "label": "Rust: Test",
      "type": "process",
      "command": "bash",
      "args": [
        "${workspaceFolder}/scripts/test.sh"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": "$rustc"
    },
    {
      "label": "Rust: Test filtered",
      "type": "process",
      "command": "bash",
      "args": [
        "${workspaceFolder}/scripts/test.sh",
        "${input:rustTestFilter}",
        "--",
        "--nocapture"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": "$rustc"
    }
  ],
  "inputs": [
    {
      "id": "rustTestFilter",
      "type": "promptString",
      "description": "Rust test-name substring (empty runs all tests)"
    }
  ]
}

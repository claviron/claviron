{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "PHP: Test",
      "type": "process",
      "command": "${env:PHP}",
      "args": ["vendor/bin/pest"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Rust: Format",
      "type": "process",
      "command": "cargo",
      "args": [
        "fmt",
        "--all"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "SQLX_OFFLINE": "true"
        }
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Rust: Check formatting",
      "type": "process",
      "command": "cargo",
      "args": [
        "fmt",
        "--all",
        "--",
        "--check"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "SQLX_OFFLINE": "true"
        }
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Rust: Clippy",
      "type": "process",
      "command": "cargo",
      "args": [
        "clippy",
        "--workspace",
        "--all-features",
        "--all-targets",
        "--",
        "-D",
        "warnings"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "SQLX_OFFLINE": "true"
        }
      },
      "group": "build",
      "problemMatcher": "$rustc"
    },
    {
      "label": "Rust: Test",
      "type": "process",
      "command": "cargo",
      "args": [
        "test",
        "--workspace",
        "--all-features",
        "--no-fail-fast"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "SQLX_OFFLINE": "true"
        }
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": "$rustc"
    }
  ]
}

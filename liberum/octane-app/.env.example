APP_NAME=OctaneExample
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://octane.test:8080

# Use a dedicated local database. These are placeholders, not credentials.
DATABASE_URL="postgresql://example:change-me@127.0.0.1:5432/example?options=-csearch_path%3Doctane"
DB_URL="${DATABASE_URL}"
MIGRATION_DATABASE_URL="${DATABASE_URL}"
DB_CONNECTION=pgsql
DB_SCHEMA=octane

CACHE_STORE=array
SESSION_DRIVER=file
SESSION_BLOCK=false
QUEUE_CONNECTION=sync
LOG_CHANNEL=stack
BROADCAST_CONNECTION=claviron

# Local demonstration values only; use private values outside this example.
PUSHER_APP_KEY=example-key
PUSHER_APP_SECRET=example-secret
PUSHER_HOST=octane.test
PUSHER_PORT=8080

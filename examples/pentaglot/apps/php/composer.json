{
  "name": "claviron/pentaglot-php",
  "description": "Minimal persistent Symfony application in the Pentaglot Edge demo",
  "type": "project",
  "license": "MIT OR Apache-2.0",
  "require": {
    "claviron/symfony": "^0.1",
    "php": "^8.4",
    "symfony/console": "8.2.x-dev",
    "symfony/framework-bundle": "8.2.x-dev"
  },
  "autoload": {
    "psr-4": {
      "Pentaglot\\Php\\": "src/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "allow-plugins": false
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}

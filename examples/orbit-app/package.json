{
  "name": "orbit-app",
  "private": true,
  "type": "module",
  "description": "A Vite application served behind a Claviron edge over Orbit Link",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "serve": "deno run --allow-ffi --allow-read --allow-env --allow-net --allow-sys --env-file=.env server.js",
    "serve:node": "node --env-file-if-exists=.env server.js",
    "serve:bun": "bun server.js"
  },
  "dependencies": {
    "@claviron/orbit": "0.1.0",
    "hono": "^4.13.13",
    "kysely": "^0.29.7",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "vite": "^8.3.4"
  }
}

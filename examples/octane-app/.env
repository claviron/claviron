# Public demo settings only. Never put credentials or personal data here.
APP_NAME=OctaneExample
APP_ENV=production
APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
APP_DEBUG=false
APP_URL=http://octane.test:8080

DB_CONNECTION=sqlite
DB_DATABASE=../database/demo.sqlite
CACHE_STORE=array
SESSION_DRIVER=file
SESSION_BLOCK=false
QUEUE_CONNECTION=sync
LOG_CHANNEL=stack
BROADCAST_CONNECTION=claviron

PUSHER_APP_KEY=example-key
PUSHER_APP_SECRET=example-secret
PUSHER_HOST=octane.test
PUSHER_PORT=8080

APP_NAME=OctaneExample
APP_ENV=local
# Public demonstration key; never reuse this configuration for a deployment.
APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
APP_DEBUG=true
APP_URL=http://octane.test:8080

# All examples use this one pre-migrated local demo database.
DB_CONNECTION=sqlite
DB_DATABASE=../database/demo.sqlite

CACHE_STORE=array
SESSION_DRIVER=file
SESSION_BLOCK=false
QUEUE_CONNECTION=sync
LOG_CHANNEL=stack
BROADCAST_CONNECTION=claviron

# Local demonstration values only; use private values outside this example.
PUSHER_APP_KEY=example-key
PUSHER_APP_SECRET=example-secret
PUSHER_HOST=octane.test
PUSHER_PORT=8080

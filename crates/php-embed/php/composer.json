{
  "name": "claviron/sapi",
  "version": "0.1.0",
  "description": "PHP declarations, fail-fast native API fallbacks and a Monolog handler for Claviron's embedded SAPI",
  "type": "library",
  "license": "MIT",
  "homepage": "https://github.com/claviron/claviron",
  "support": {
    "issues": "https://github.com/claviron/claviron/issues",
    "source": "https://github.com/claviron/claviron/tree/main/crates/php-embed/php"
  },
  "require": {
    "php": ">=8.2",
    "monolog/monolog": "^3.0"
  },
  "autoload": {
    "psr-4": {
      "Claviron\\": "src/"
    },
    "files": [
      "fallback/functions.php",
      "fallback/types.php"
    ]
  }
}

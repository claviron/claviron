# Expected version is checked before starting or reloading FPM.
PHP_VERSION=8.5.12
PHP_INSTALL_DIR=/opt/php-zts-embed
# Native configuration stays inside the selected installation.
# php-fpm.conf may include independently maintained site pool files.
PHP_CONFIG_DIR=/opt/php-zts-embed/etc
PHP_INI_SCAN_DIR=/opt/php-zts-embed/etc/conf.d/fpm
